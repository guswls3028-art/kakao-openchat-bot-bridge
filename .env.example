KAKAO_BOT_HOST=0.0.0.0
KAKAO_BOT_PORT=4040
KAKAO_BOT_SECRET=change-this-long-random-secret
# HMAC을 켜면 x-bot-timestamp, x-bot-nonce, x-bot-signature가 모두 필요합니다.
# signature = HMAC_SHA256(secret, `${timestamp}.${nonce}.${rawBody}`)
KAKAO_WEBHOOK_HMAC_SECRET=
KAKAO_WEBHOOK_HMAC_MAX_SKEW_MS=300000
# secret 없이 공개 바인딩을 허용해야 하는 격리 로컬 테스트에서만 true.
KAKAO_ALLOW_INSECURE_WEBHOOK=false
KAKAO_WEBHOOK_TIMEOUT_MS=12000
KAKAO_BATCH_MAX_MESSAGES=25
KAKAO_ROOM_ALLOWLIST=테스트방,운영방
# production에서는 allowlist 필수. 모든 방 허용이 의도일 때만 true.
KAKAO_ALLOW_ALL_ROOMS=false
KAKAO_BOT_NICKNAMES=오픈채팅봇,봇계정닉
KAKAO_ADMIN_SENDERS=방장,운영자
# 카카오 openchat은 닉네임이 spoof 가능하므로 기본 비활성. 꼭 필요할 때만 true.
KAKAO_ALLOW_SENDER_ADMIN_COMMANDS=false
KAKAO_BOT_MENTION=@봇
KAKAO_BOT_DATA_DIR=./data

# Optional: forward /질문 messages to your own service.
QUESTION_API_ENDPOINT=
QUESTION_API_SECRET=
QUESTION_API_TIMEOUT_MS=6000
QUESTION_DEDUPE_TTL_MS=86400000
PUBLIC_BASE_URL=
